COMPOSE_PROJECT_NAME=marketplace

FRONTEND_PORT=3000
STORYBOOK_PORT=6006
WEB_PORT=8080
SWAGGER_UI_PORT=8081
REDOC_PORT=8082
POSTGRES_PORT=5433
PGADMIN_PORT=5050
REDIS_PORT=6381
REVERB_PORT=8083
ELASTICSEARCH_PORT=9201
KIBANA_PORT=5601

# Elasticsearch (docker-compose service)
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.18.0
ELASTICSEARCH_DISCOVERY_TYPE=single-node
ELASTICSEARCH_XPACK_SECURITY_ENABLED=true
ELASTICSEARCH_XPACK_HTTP_SSL_ENABLED=false
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=marketplace-elastic-local
KIBANA_SYSTEM_PASSWORD=marketplace-kibana-system-local
ELASTICSEARCH_XPACK_ML_ENABLED=false
ELASTICSEARCH_INGEST_GEOIP_DOWNLOADER_ENABLED=false
ELASTICSEARCH_JAVA_OPTS=-Xms256m -Xmx256m
ELASTICSEARCH_MEM_LIMIT=512m
ELASTICSEARCH_CPUS=0.25
ELASTICSEARCH_HEALTHCHECK_INTERVAL=15s
ELASTICSEARCH_HEALTHCHECK_TIMEOUT=5s
ELASTICSEARCH_HEALTHCHECK_RETRIES=10
ELASTICSEARCH_HEALTHCHECK_START_PERIOD=90s

# Kibana (docker-compose service)
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:8.18.0
KIBANA_ELASTICSEARCH_HOSTS=http://elasticsearch:9200
KIBANA_ELASTICSEARCH_USERNAME=kibana_system
KIBANA_ELASTICSEARCH_PASSWORD=marketplace-kibana-system-local
KIBANA_SERVER_NAME=kibana
KIBANA_NODE_OPTIONS=--max-old-space-size=512
KIBANA_MEM_LIMIT=768m
KIBANA_CPUS=0.25
KIBANA_SECURITY_ENCRYPTION_KEY=marketplace-kibana-security-key-32chars
KIBANA_ENCRYPTED_SAVED_OBJECTS_KEY=marketplace-kibana-saved-objects-key
KIBANA_REPORTING_ENCRYPTION_KEY=marketplace-kibana-reporting-key-32c
KIBANA_HEALTHCHECK_INTERVAL=20s
KIBANA_HEALTHCHECK_TIMEOUT=20s
KIBANA_HEALTHCHECK_RETRIES=12
KIBANA_HEALTHCHECK_START_PERIOD=180s

# Frontend presence heartbeat
NUXT_PUBLIC_PRESENCE_HEARTBEAT_INTERVAL_SECONDS=30
NUXT_PUBLIC_PRESENCE_HEARTBEAT_MAX_BACKOFF_SECONDS=300
NUXT_PUBLIC_PRESENCE_HEARTBEAT_PAUSE_WHEN_HIDDEN=true

# Frontend Reverb/Echo
NUXT_PUBLIC_REVERB_ENABLED=true
NUXT_PUBLIC_REVERB_APP_KEY=local-app-key
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8083
NUXT_PUBLIC_REVERB_SCHEME=http
NUXT_PUBLIC_REVERB_AUTH_ENDPOINT=/broadcasting/auth
